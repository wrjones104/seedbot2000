# Django site under gunicorn, behind nginx on the shared AP Alerts VM.
# Binds to loopback only; nginx terminates TLS and proxies seedbot.net here.
# Port 5000 belongs to AP Alerts, so SeedBot uses 8000.
#
# Install: sudo cp deploy/systemd/seedbot-*.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now seedbot-web

[Unit]
Description=SeedBot web (gunicorn)
After=network.target

[Service]
User=seedbot
Group=seedbot
WorkingDirectory=/srv/seedbot
# Group-readable output so nginx (www-data, in the seedbot group) can serve it.
UMask=0027
# settings.py loads /srv/seedbot/.env itself; no EnvironmentFile needed.
# --timeout 120 matches the longest synchronous subprocess call in the codebase.
ExecStart=/srv/seedbot/.venv/bin/gunicorn seedbot_project.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
