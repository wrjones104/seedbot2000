# Django site under gunicorn, behind nginx.
# Binds to loopback only; nginx terminates TLS and proxies seedbot.net here.
#
# Install: sudo cp deploy/systemd/seedbot-*.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now seedbot-web

[Unit]
Description=SeedBot web (gunicorn)
After=network.target

[Service]
User=seedbot
Group=seedbot
WorkingDirectory=/var/www/seedbot_project
# Group-readable output so nginx (www-data, in the seedbot group) can serve it.
UMask=0027
# settings.py loads /var/www/seedbot_project/.env itself; no EnvironmentFile needed.
# Seed rolls run in Celery, not here, so a couple of workers is plenty.
# --timeout 120 matches the longest synchronous subprocess call in the codebase.
ExecStart=/var/www/seedbot_project/.venv/bin/gunicorn seedbot_project.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
